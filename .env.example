# Copiar a .env. Valores de desarrollo local (docker-compose.yml).

# Puerto del host para el Postgres del compose. Cambialo si ya tenés uno en 5432
# (y actualizá las dos URLs de abajo).
POSTGRES_PORT=5432

# Runtime de apps/api. Rol sin CREATE y sin UPDATE/DELETE por default (ADR-002).
DATABASE_URL=postgresql://hs_app:hs_app_dev@localhost:5432/hs_platform

# Solo para correr migraciones (`pnpm db:migrate`) y para instalar el esquema de
# trabajos (`pnpm db:jobs:install`, ADR-005). Nunca se usa desde el proceso de la API.
MIGRATION_DATABASE_URL=postgresql://hs_migrator:hs_migrator_dev@localhost:5432/hs_platform

PORT=3000

# `pnpm demo:data` — el entorno de demo local. NO lo toca ningún otro comando: el
# script se corre a mano y se niega a correr con NODE_ENV=production, porque siembra una
# contraseña conocida. Mínimo 12 caracteres (`passwordSchema`).
#
# `API_BASE_URL` es a dónde le manda la aceptación de la invitación, que es la única
# parte del script que va por HTTP y no por SQL.
API_BASE_URL=http://localhost:3000
DEMO_PASSWORD=demo-inspector-2026

# ADR-011 — Firma de los tokens de sesión. Mínimo 32 caracteres; sin esto la API
# no arranca, a propósito: un default acá sería un default en producción.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# ADR-005 — El planificador pg-boss, adentro del proceso de la API. `false` lo apaga:
# la API sigue sirviendo HTTP y los trabajos programados no corren. Solo para
# desarrollo y para las suites que no los necesitan.
#
# El esquema que consume lo crea `pnpm db:jobs:install`, que es un paso de despliegue
# al lado de `pnpm db:migrate`. Con el esquema ausente la API no arranca, a propósito.
JOBS_ENABLED=true

# ADR-006 — Almacenamiento de objetos S3-compatible. La API solo FIRMA subidas: el PUT
# va directo del dispositivo al bucket y el proceso de Node nunca ve los bytes.
#
# EL BUCKET TIENE QUE TENER VERSIONING ACTIVADO, y la credencial de acá tiene que estar
# limitada a `PutObject` sobre su prefijo. SIN `DeleteObject`: una foto es
# la evidencia de un hallazgo y este sistema no tiene forma de borrarla, ni por error ni
# a propósito. La ausencia de ese permiso es la mitad que el código no puede aplicar.
#
# Puertos del host para el MinIO del compose. Cambialos si ya tenés algo en 9000/9001.
S3_PORT=9000
S3_CONSOLE_PORT=9001

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hs-platform-dev
S3_ACCESS_KEY_ID=hs_uploads_dev
S3_SECRET_ACCESS_KEY=hs_uploads_dev_secret

# Los bucket S3-compatibles (MinIO, Garage) sirven por path y no por subdominio.
# `false` solo para S3 de AWS real.
S3_FORCE_PATH_STYLE=true

# Vida de una URL firmada. Corta a propósito: se pide justo antes del PUT y se usa en el
# acto (design D7 de `offline-inspection-capture`).
S3_UPLOAD_TTL_SECONDS=300

# Los orígenes de la PWA que la API acepta (CORS). Lista blanca separada por comas,
# nunca `*`: un comodín le daría a cualquier página del navegador del inspector permiso
# para hablarle a la API con su sesión.
WEB_ORIGINS=http://localhost:5173,http://localhost:4173
