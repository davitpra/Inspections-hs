{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@hs/config library (paquete publicado a apps/web y apps/api)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
