{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pwa": "pnpm build && vite preview",
    "build": "node scripts/check-tokens.mjs && tsc -b && vite build && node scripts/check-service-worker.mjs",
